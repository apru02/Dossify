# Supabase → Project Settings → API Keys. The publishable (or legacy "anon") key is safe to expose:
# every table is protected by Row-Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Base URL used in auth redirect links (email confirmation, Google OAuth).
# Local: http://localhost:3000. Production: your Vercel URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Google AI Studio → https://aistudio.google.com/apikey (free, no card). Server-only.
GEMINI_API_KEY=your-gemini-api-key

# Optional overrides (defaults shown).
# GEMINI_CHAT_MODELS=gemini-flash-lite-latest,gemini-3.1-flash-lite,gemini-flash-latest
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# RAG_MIN_SIMILARITY=0.6

# "Add to Slack": ONE Slack app for this deployment; each Dossify workspace connects its own
# channel from Settings → Integrations. api.slack.com/apps → your app → Basic Information.
SLACK_CLIENT_ID=1234567890.1234567890
SLACK_CLIENT_SECRET=your-slack-client-secret

# Encrypts each workspace's Slack webhook before it's stored. 32 random bytes, base64:
#   openssl rand -base64 32
# Keep it stable: changing it makes existing Slack connections unreadable (reconnect needed).
INTEGRATIONS_ENCRYPTION_KEY=

# Invitation emails over SMTP (any provider). Optional: without it, admins get a link to share.
# Gmail: smtp.gmail.com / 587 / your address / a 16-char App Password (needs 2-Step Verification).
# Brevo: smtp-relay.brevo.com / 587 / your SMTP login / SMTP key.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM="Dossify <you@gmail.com>"